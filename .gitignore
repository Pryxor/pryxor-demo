# Runtime state (regenerated by `make seed`)
mail/*.eml
transcripts/*.json
logs/
audit/

# Keep the .gitkeep placeholders so the dirs survive a fresh clone
!transcripts/.gitkeep
!mail/.gitkeep
!audit/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local secrets — never commit real values
.env
.env.local

# Bank state volume (if mounted locally as ./data)
data/

# OS cruft
.DS_Store
Thumbs.db

secrets.testenv
